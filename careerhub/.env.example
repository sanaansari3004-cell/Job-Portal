# --- Database ---
DATABASE_URL="postgresql://careerhub:careerhub@localhost:5432/careerhub?schema=public"

# --- Auth ---
# Generate a long random string, e.g. `openssl rand -base64 32`
JWT_SECRET="change-me-to-a-long-random-secret"

# --- File storage ---
# Default driver: "local" (files stored on disk under ./uploads).
# Set to "s3" to use S3-compatible storage. NOTE: the S3 driver is
# configured but UNTESTED — local disk is the supported default.
STORAGE_DRIVER="local"

# --- S3 settings (only used when STORAGE_DRIVER=s3) ---
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
